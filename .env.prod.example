# Copy to .env.prod and fill in real values. NEVER commit .env.prod.
# Used by: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# --- PostgreSQL ---
POSTGRES_USER=pomodoro
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=pomodoro

# --- Auth (shared by NestJS backend AND the Go stats service) ---
# Must be >= 16 chars. Generate e.g. with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d

# --- CORS ---
# Comma-separated browser origins allowed to call the API.
# For same-origin behind Caddy this can be your site URL.
FRONTEND_ORIGIN=https://pomodoro.example.com

# --- Public domain (drives Caddy automatic HTTPS) ---
# Production: a real hostname pointing at this server's IP.
# Local test: "localhost" (Caddy local CA) or ":80" (plain HTTP).
DOMAIN=pomodoro.example.com
