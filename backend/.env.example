# backend/.env.example — copy to .env and fill in real values (never commit .env)

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pomodoro?schema=public"

# JWT signing secret — REQUIRED, must be >= 16 chars.
# The Go stats service must use this SAME value to verify tokens (HS256).
JWT_SECRET="change-me-to-a-long-random-string"

# Optional: token lifetime (ms-style string). Defaults to 1d.
JWT_EXPIRES_IN="1d"

# Optional: comma-separated list of allowed browser origins for CORS.
# Example: https://pomodoro.example.com,http://localhost:3001
# (chrome-extension:// origins are always allowed for the extension.)
FRONTEND_ORIGIN=""

# Port the API listens on (defaults to 3000)
PORT=3000
